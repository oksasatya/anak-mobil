  "query": "\n        SELECT id, build_id, part_id, install_date, mileage_km,\n               cost, garage_name, notes, removed_at\n        FROM modifications\n        WHERE build_id = ANY($1)\n        ORDER BY build_id, install_date DESC NULLS LAST, id\n        ",
