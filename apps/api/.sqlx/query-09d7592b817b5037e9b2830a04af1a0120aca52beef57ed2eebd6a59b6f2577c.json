  "db_name": "PostgreSQL",
  "query": "\n        INSERT INTO builds (id, vehicle_id, notes, visibility)\n        SELECT $1, v.id, $4, $5\n        FROM vehicles v\n        WHERE v.id = $3 AND v.owner_id = $2\n        ON CONFLICT (vehicle_id) DO UPDATE\n            SET notes = EXCLUDED.notes, visibility = EXCLUDED.visibility\n        RETURNING id\n        ",
