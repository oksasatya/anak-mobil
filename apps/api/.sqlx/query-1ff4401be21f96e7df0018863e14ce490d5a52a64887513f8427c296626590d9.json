  "query": "\n        SELECT b.id, b.vehicle_id, b.notes, b.visibility AS \"visibility: Visibility\"\n        FROM builds b\n        JOIN vehicles v ON v.id = b.vehicle_id\n        WHERE b.id = $2\n          AND (b.visibility <> 'private' OR v.owner_id = $1)\n        ",
