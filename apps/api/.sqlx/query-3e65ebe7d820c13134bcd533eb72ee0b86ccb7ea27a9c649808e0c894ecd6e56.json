{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            s.id,\n            s.vehicle_id,\n            s.service_date,\n            s.mileage_km,\n            s.category AS \"category: ServiceCategory\",\n            s.parts_replaced,\n            s.garage_name,\n            s.cost,\n            s.notes\n        FROM service_records s\n        JOIN vehicles v ON v.id = s.vehicle_id\n        WHERE v.owner_id = $1 AND s.id = $2\n        ",
