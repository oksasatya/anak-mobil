  "query": "\n        SELECT\n            u.id,\n            u.email::text        AS \"email!\",\n            u.username::text     AS \"username?\",\n            u.display_name       AS \"display_name?\",\n            EXISTS(SELECT 1 FROM vehicles v WHERE v.owner_id = u.id) AS \"has_vehicles!\"\n        FROM users u\n        WHERE u.id = $1\n        ",
