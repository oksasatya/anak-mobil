{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            b.id,\n            b.vehicle_id,\n            b.notes,\n            b.visibility AS \"visibility: Visibility\",\n            v.owner_id,\n            v.variant_id,\n            v.nickname,\n            v.described_as,\n            v.cost_visibility AS \"cost_visibility: Visibility\"\n        FROM builds b\n        JOIN vehicles v ON v.id = b.vehicle_id\n        WHERE (b.visibility <> 'private' OR v.owner_id = $1)\n          AND ($2::uuid IS NULL OR b.id < $2)\n        ORDER BY b.id DESC\n        LIMIT $3\n        ",
