# Copy to .env for local development. Never commit .env itself.
#
# Every key below is read once at startup by `Config::from_env()`.
# Missing or malformed values are ALL reported together, then the process
# exits — it never starts half-configured.

# development | production
# Production additionally refuses to start when a URL points at localhost.
APP_ENV=development

# host:port the HTTP role binds to. The port is required.
BIND_ADDR=0.0.0.0:8080

# trace | debug | info | warn | error
LOG_LEVEL=info

# Required. Must start with `postgres`.
DATABASE_URL=postgres://anakmobil:anakmobil@localhost:5432/anakmobil

# Required. Must start with `redis`.
# Sessions (revocable JWT), rate limiting, and read cache.
REDIS_URL=redis://localhost:6379

# sqlx compile-time macros read the schema from a live database when
# DATABASE_URL is set, and IGNORE the committed .sqlx cache. That is why
# builds run with SQLX_OFFLINE=true — see the Makefile — so a stale cache
# fails locally instead of only in CI.
# SQLX_OFFLINE=true
