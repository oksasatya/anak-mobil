---
/**
 * The document shell. Everything a crawler and a social preview need lives
 * here, filled from props rather than hardcoded per page — AM-341 AC4 fails
 * the moment one page forgets its description.
 */
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Page path, e.g. "/" or "/tentang". Canonical is built from it. */
  path?: string;
}

const { title, description, path = "/" } = Astro.props;

const canonical = new URL(path, Astro.site).href;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="180x180" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AnakMobil.id" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/* og:image and twitter:card arrive with the real share image in AM-341.
        A card pointing at a missing file renders as a broken preview, which
        reads worse than a plain link. */}
    <meta name="twitter:card" content="summary" />

    {/* Matches the token so the browser chrome does not flash a different
        colour than the page behind it. */}
    <meta name="theme-color" content="#1D232A" />
  </head>
  <body>
    <slot />
  </body>
</html>
