---
/**
 * Daftar waitlist (AM-341). The form and its states are designed here, but the
 * backend that would store an email is AM-346 and does not exist yet.
 *
 * So the form is shown but NOT wired to a fake success: the export saved to the
 * visitor's own localStorage, which looks like a signup but means no one at
 * AnakMobil ever receives the email — that is worse than honest. Instead the
 * fields are a disabled preview, the submit says plainly it is not open yet,
 * and a real working action (a mailto) is offered for anyone who wants to be
 * reminded early. When AM-346 lands, this page becomes a live React island.
 */
import Shell from "../layouts/Shell.astro";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";

const title = "Daftar waitlist — AnakMobil.id";
const description =
  "Waitlist AnakMobil.id. Aplikasinya masih dibangun — daftar untuk dikabari begitu pendaftaran dibuka. Satu email, tidak dibagikan ke siapa pun.";

const trust = [
  { icon: "mail", t: "Satu email waktu pendaftaran dibuka — bukan newsletter mingguan." },
  { icon: "shield-check", t: "Yang disimpan cuma email kamu — plus baris mobil kalau kamu isi." },
  { icon: "trash-2", t: "Mau dihapus? Tulis ke halo@anakmobil.id — beres." },
] as const;
---

<Shell title={title} description={description} path="/daftar" active="daftar">
  <section class="wrap reveal">
    <div class="head-top">
      <span class="jalur" aria-hidden="true"></span>
      <span class="am-label kicker">Waitlist</span>
    </div>
    <h1>Jadi yang pertama.</h1>
    <p class="sub">
      Aplikasinya masih dibangun. Satu email — kami kabari begitu pendaftaran dibuka. Itu aja.
    </p>

    <div class="card-slot">
      <Card padding="26px" floating raised>
        <div class="banner">
          <span class="banner-icon"><Icon name="circle-alert" size={17} strokeWidth={2} /></span>
          <div>
            <div class="banner-t">Pendaftaran waitlist belum dibuka.</div>
            <div class="banner-s">
              Formulir ini aktif begitu sistem penyimpanannya siap — dan sampai itu, kami tidak akan
              pura-pura emailmu tersimpan. Mau diingatkan duluan? Pakai tombol email di bawah.
            </div>
          </div>
        </div>

        <form class="form" aria-describedby="form-status">
          <div class="field">
            <label for="email">Email</label>
            <input
              id="email"
              type="email"
              placeholder="nama@email.com"
              autocomplete="email"
              disabled
            />
          </div>
          <div class="field">
            <label for="car">Sebut mobilmu (opsional)</label>
            <input id="car" type="text" placeholder="Civic FD1 2008 — daily" disabled />
            <span class="hint">Satu baris aja — biar kabar pertamamu relevan.</span>
          </div>
          <button class="submit" type="submit" disabled aria-disabled="true">
            Aktif begitu pendaftaran dibuka
          </button>
        </form>

        <div class="alt">
          <span class="alt-label">Mau diingatkan lebih dulu?</span>
          <a
            class="alt-btn"
            href="mailto:halo@anakmobil.id?subject=Ingatkan%20saya%20soal%20waitlist%20AnakMobil"
          >
            <Icon name="mail" size={16} /> Email halo@anakmobil.id
          </a>
        </div>

        <p class="consent" id="form-status">
          Begitu formulir aktif, dengan mendaftar kamu setuju email disimpan hanya untuk kabar
          peluncuran AnakMobil — tidak dibagikan ke siapa pun, tidak dipakai untuk hal lain, dan bisa
          dihapus kapan saja. <a href="/privasi">Kebijakan privasi</a>
        </p>
      </Card>
    </div>

    <div class="trust">
      {
        trust.map((r) => (
          <div class="trust-row">
            <span class="trust-icon">
              <Icon name={r.icon} size={17} />
            </span>
            <span>{r.t}</span>
          </div>
        ))
      }
    </div>
  </section>
</Shell>

<style>
  .wrap {
    max-width: 620px;
    margin: 0 auto;
    padding: clamp(44px, 7vw, 72px) clamp(16px, 4vw, 28px) clamp(56px, 8vw, 88px);
  }
  .head-top {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .jalur {
    width: 40px;
    height: 3px;
    border-radius: var(--radius-pill);
    background: var(--accent-500);
    flex: none;
  }
  .kicker {
    color: var(--color-text-tertiary);
  }
  h1 {
    font: var(--type-h1);
    font-size: clamp(30px, 5vw, 42px);
    line-height: 1.16;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin: 10px 0 0;
  }
  .sub {
    font: var(--type-body);
    color: var(--color-text-secondary);
    margin: 12px 0 0;
  }
  .card-slot {
    margin-top: 28px;
  }

  .banner {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    border: 1px solid color-mix(in srgb, var(--info) 45%, var(--color-border));
    background: color-mix(in srgb, var(--info) 8%, transparent);
    border-radius: var(--radius-md);
    padding: 12px 14px;
    margin-bottom: 18px;
  }
  .banner-icon {
    color: var(--info);
    flex: none;
    margin-top: 1px;
    display: inline-flex;
  }
  .banner-t {
    font: 600 13px/19px var(--font-sans);
    color: var(--color-text-primary);
  }
  .banner-s {
    font: 400 12px/18px var(--font-sans);
    color: var(--color-text-secondary);
    margin-top: 2px;
  }

  .form {
    display: grid;
    gap: 16px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field label {
    font: 600 13px/18px var(--font-sans);
    color: var(--color-text-primary);
  }
  .field input {
    width: 100%;
    height: 48px;
    padding: 0 14px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
    color: var(--color-text-primary);
    font: 400 15px/1.4 var(--font-sans);
    /* Inputs are a preview until AM-346; keep them legible but clearly inert. */
    cursor: not-allowed;
  }
  .field input::placeholder {
    color: var(--color-text-tertiary);
  }
  .hint {
    font: 400 12px/17px var(--font-sans);
    color: var(--color-text-tertiary);
  }
  .submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 52px;
    padding: 0 22px;
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    background: var(--color-surface-subtle);
    color: var(--color-text-tertiary);
    font: 600 15px/1 var(--font-sans);
    cursor: not-allowed;
  }

  .alt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border);
  }
  .alt-label {
    font: 400 13px/18px var(--font-sans);
    color: var(--color-text-secondary);
  }
  .alt-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text-primary);
    font: 600 14px/1 var(--font-sans);
    text-decoration: none;
    transition: background var(--duration-micro) var(--ease-out);
  }
  .alt-btn:hover {
    background: var(--color-surface-subtle);
  }

  .consent {
    font: 400 12px/18px var(--font-sans);
    color: var(--color-text-tertiary);
    margin: 14px 0 0;
  }
  .consent a {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .trust {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 26px;
  }
  .trust-row {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font: 400 13px/20px var(--font-sans);
    color: var(--color-text-secondary);
  }
  .trust-icon {
    color: var(--color-text-tertiary);
    flex: none;
    margin-top: 1px;
    display: inline-flex;
  }
</style>
