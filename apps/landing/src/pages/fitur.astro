---
/**
 * Fitur — the three pillars, deeper (AM-341). Each pillar pairs a text column
 * with an honest empty/example visual: a service timeline waiting for its
 * first entry, a spec sheet with blank fields left blank, and a scoped-question
 * preview. No invented data anywhere.
 */
import Shell from "../layouts/Shell.astro";
import PageHeader from "../components/PageHeader.astro";
import Card from "../components/Card.astro";
import Badge from "../components/Badge.astro";
import Chip from "../components/Chip.astro";
import Icon from "../components/Icon.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CtaBand from "../components/CtaBand.astro";

const title = "Riwayat servis, build & komunitas — AnakMobil.id";
const description =
  "Tiga pilar AnakMobil lebih dalam: riwayat servis yang bertahan, build sebagai data, dan komunitas yang terarah per mobil. Masih dibangun.";

const riwayatChecks = [
  "Tanggal, KM, dan biaya sebagai data — bukan foto nota yang buram.",
  "Riwayat ikut mobil waktu dijual — nilai bekasnya kebawa.",
  "Pengingat servis dihitung dari riwayat kamu sendiri.",
];
const buildChecks = [
  "Per bagian — wheels, suspension, engine — bukan satu caption panjang.",
  "Angka yang sama di build lain bisa langsung dibandingkan.",
];
const tanyaChecks = [
  "Pertanyaan diarahkan per brand, model, dan generasi.",
  "Jawaban nempel ke mobil dan part yang bersangkutan.",
  "Masalah yang selesai jadi arsip buat pemilik berikutnya.",
];
---

<Shell title={title} description={description} path="/fitur" active="fitur">
  <PageHeader
    kicker="Fitur"
    title="Tiga pilar, lebih dalam."
    sub="Semuanya berangkat dari satu hal: mobil kamu sebagai data yang rapi — bukan folder foto dan ingatan yang pudar."
  />

  <!-- Pillar 1 — Riwayat -->
  <section id="riwayat" class="pillar reveal">
    <div class="container two-col">
      <div class="col-text">
        <div class="am-label kicker">Pilar 01 — Riwayat servis</div>
        <h2>Riwayat servis yang bertahan</h2>
        <p class="lede">
          Catat servis sekali: tanggal, KM, bengkel, biaya, item pekerjaannya. Catatan itu nempel ke
          mobil — bukan ke HP, bukan ke bengkel. Waktu mobilnya pindah tangan, riwayatnya ikut:
          pembeli lihat perawatan yang jelas, dan harga jual kamu punya bukti.
        </p>
        <div class="checks">
          {
            riwayatChecks.map((c) => (
              <div class="check">
                <span class="ok">
                  <Icon name="check" size={16} strokeWidth={2} />
                </span>
                <span>{c}</span>
              </div>
            ))
          }
        </div>
      </div>
      <div class="col-visual">
        <Card padding="20px" raised class="visual-card">
          <div class="card-head">
            <span class="am-label muted">Riwayat servis</span>
            <span class="am-spec dim">0 KM tercatat</span>
          </div>
          <div class="tl">
            <div class="tl-rail">
              <span class="tl-dot on"></span>
              <span class="tl-line on"></span>
            </div>
            <div class="tl-box on">
              <div class="tl-t">Servis pertama kamu</div>
              <div class="tl-s">Tanggal · KM · Bengkel · Biaya — tercatat di sini.</div>
            </div>
          </div>
          <div class="tl faded">
            <div class="tl-rail">
              <span class="tl-dot"></span>
              <span class="tl-line"></span>
            </div>
            <div class="tl-box"><div class="tl-s">Servis berikutnya</div></div>
          </div>
          <div class="tl faded-more">
            <div class="tl-rail"><span class="tl-dot"></span></div>
            <div class="tl-box"><div class="tl-s">Dan seterusnya — riwayatnya panjang umur.</div></div>
          </div>
          <p class="note">Belum ada data — dan memang begitu. Timeline ini nunggu mobil kamu.</p>
          <div class="example">
            <div class="am-label muted example-label">Contoh format entri</div>
            <ServiceCard
              km="146.120 KM"
              when="Contoh entri"
              items={["Engine Oil", "Oil Filter"]}
              garage="Bengkel langganan kamu"
              cost="Rp850.000"
            />
          </div>
        </Card>
      </div>
    </div>
  </section>

  <!-- Pillar 2 — Build -->
  <section id="build" class="pillar subtle reveal">
    <div class="container two-col">
      <div class="col-text">
        <div class="am-label kicker">Pilar 02 — Build</div>
        <h2>Build sebagai data, bukan album foto</h2>
        <p class="lede">
          Album foto tidak bisa dibandingkan. Angka bisa. Offset, PCD, ukuran ban — per part, sebagai
          spesifikasi terstruktur. Build kamu jadi bisa dibaca, dicari, dan disandingkan dengan build
          lain di mobil yang sama.
        </p>
        <div class="checks">
          <div class="check">
            <span class="ok"><Icon name="check" size={16} strokeWidth={2} /></span>
            <span>
              Spek velg dan ban sebagai angka: <b class="am-spec">18×8.5 ET40</b>,
              <b class="am-spec">225/40 R18</b>.
            </span>
          </div>
          {
            buildChecks.map((c) => (
              <div class="check">
                <span class="ok">
                  <Icon name="check" size={16} strokeWidth={2} />
                </span>
                <span>{c}</span>
              </div>
            ))
          }
        </div>
      </div>
      <div class="col-visual">
        <Card padding="20px" class="visual-card">
          <div class="card-head">
            <span class="am-label muted">Spec sheet</span>
            <Badge>Contoh format</Badge>
          </div>
          <div class="am-label group">Wheels</div>
          <div class="spec-rows">
            <div class="spec-row bd">
              <span class="spec-k">Velg</span><span class="am-spec spec-v">18×8.5 ET40</span>
            </div>
            <div class="spec-row bd">
              <span class="spec-k">PCD</span><span class="am-spec spec-v">5×114.3</span>
            </div>
            <div class="spec-row">
              <span class="spec-k">Ban</span><span class="am-spec spec-v">225/40 R18</span>
            </div>
          </div>
          <div class="am-label group">Suspension</div>
          <div class="spec-row">
            <span class="spec-k">Coilover</span><span class="spec-empty">— belum diisi</span>
          </div>
          <p class="note">Kolom yang kosong dibiarkan kosong — bukan diisi karangan.</p>
        </Card>
      </div>
    </div>
  </section>

  <!-- Pillar 3 — Komunitas -->
  <section id="tanya" class="pillar reveal">
    <div class="container two-col">
      <div class="col-text">
        <div class="am-label kicker">Pilar 03 — Komunitas</div>
        <h2>Orang yang pernah di posisi kamu</h2>
        <p class="lede">
          Forum umum jawabannya "tergantung". Di sini pertanyaan kamu terarah: ke pemilik brand,
          model, dan generasi yang sama — syukur-syukur yang sudah pasang part yang persis sama.
          Jawabannya dari pengalaman, bukan tebakan.
        </p>
        <div class="checks">
          {
            tanyaChecks.map((c) => (
              <div class="check">
                <span class="ok">
                  <Icon name="check" size={16} strokeWidth={2} />
                </span>
                <span>{c}</span>
              </div>
            ))
          }
        </div>
      </div>
      <div class="col-visual">
        <Card padding="20px" raised class="visual-card">
          <div class="card-head">
            <span class="am-label muted">Pertanyaan terarah</span>
            <Badge>Pratinjau</Badge>
          </div>
          <div class="chips">
            <Chip selected>Honda</Chip>
            <Chip selected>Civic</Chip>
            <Chip selected>FD · 2006–2011</Chip>
          </div>
          <div class="q-box">
            Coilover merk X di FD buat daily — masih nyaman buat harian?
          </div>
          <div class="reach">
            <Icon name="users" size={15} />
            <span>Sampai ke pemilik Civic FD yang pernah pasang part serupa — bukan ke semua orang.</span>
          </div>
          <p class="note bd-top">Pratinjau bentuk pertanyaan — bukan feed sungguhan.</p>
        </Card>
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section class="cta reveal">
    <div class="container">
      <CtaBand
        heading="Fitur-fitur ini lagi dibangun."
        body="Daftar waitlist — kami kabari sekali begitu pendaftaran dibuka, dan kamu yang pertama nyobain."
      />
    </div>
  </section>
</Shell>

<style>
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 28px);
  }
  .kicker {
    color: var(--color-text-tertiary);
  }

  .pillar {
    border-top: 1px solid var(--color-border);
    padding: clamp(44px, 7vw, 72px) 0;
    scroll-margin-top: 80px;
  }
  .pillar.subtle {
    background: var(--color-surface-subtle);
  }
  .two-col {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 5vw, 56px);
    align-items: flex-start;
  }
  .col-text {
    flex: 1 1 400px;
    min-width: min(100%, 300px);
  }
  .col-visual {
    flex: 1 1 380px;
    min-width: min(100%, 290px);
  }
  .visual-card {
    max-width: 480px;
    margin: 0 auto;
  }
  h2 {
    font: var(--type-h2);
    font-size: clamp(24px, 3.8vw, 34px);
    line-height: 1.22;
    color: var(--color-text-primary);
    margin: 10px 0 0;
  }
  .lede {
    font: 400 15px/24px var(--font-sans);
    color: var(--color-text-secondary);
    margin: 14px 0 0;
    max-width: 560px;
  }
  .checks {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 22px;
  }
  .check {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font: 400 14px/21px var(--font-sans);
    color: var(--color-text-secondary);
  }
  .check .ok {
    color: var(--success);
    flex: none;
    margin-top: 2px;
    display: inline-flex;
  }
  .check b {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .muted {
    color: var(--color-text-tertiary);
  }
  .dim {
    font-size: 13px;
    color: var(--color-text-secondary);
  }
  .note {
    font: 400 12px/17px var(--font-sans);
    color: var(--color-text-tertiary);
    margin: 14px 0 0;
  }
  .note.bd-top {
    border-top: 1px solid var(--color-border);
    padding-top: 12px;
  }

  /* Timeline (pillar 1) */
  .tl {
    display: flex;
    gap: 14px;
    margin-top: 16px;
  }
  .tl.faded {
    opacity: 0.55;
    margin-top: 0;
  }
  .tl.faded-more {
    opacity: 0.3;
    margin-top: 0;
  }
  .tl-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: none;
    width: 12px;
  }
  .tl-dot {
    width: 12px;
    height: 12px;
    border-radius: 99px;
    border: 2px solid var(--color-border-strong);
    background: var(--color-surface);
    flex: none;
  }
  .tl-dot.on {
    border-color: var(--accent-500);
  }
  .tl-line {
    flex: 1;
    width: 0;
    border-left: 2px dashed var(--color-border);
    margin-top: 4px;
  }
  .tl-line.on {
    border-left-color: var(--color-border-strong);
  }
  .tl-box {
    flex: 1;
    border: 1.5px dashed var(--color-border);
    border-radius: var(--radius-md);
    padding: 12px 14px;
    margin-bottom: 14px;
  }
  .tl-box.on {
    border-color: var(--color-border-strong);
    padding: 14px;
  }
  .tl-t {
    font: 600 14px/19px var(--font-sans);
    color: var(--color-text-primary);
  }
  .tl-s {
    font: 400 13px/18px var(--font-sans);
    color: var(--color-text-tertiary);
  }
  .tl-box.on .tl-s {
    font-size: 12px;
    line-height: 17px;
    margin-top: 4px;
  }
  .example {
    border-top: 1px solid var(--color-border);
    margin-top: 16px;
    padding-top: 14px;
  }
  .example-label {
    margin-bottom: 10px;
  }

  /* Spec sheet (pillar 2) */
  .group {
    color: var(--color-text-secondary);
    margin-top: 16px;
  }
  .spec-rows {
    display: flex;
    flex-direction: column;
    margin-top: 6px;
  }
  .spec-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 0;
  }
  .spec-row.bd {
    border-bottom: 1px solid var(--color-border);
  }
  .spec-k {
    font: 400 13px/18px var(--font-sans);
    color: var(--color-text-secondary);
  }
  .spec-v {
    font-size: 15px;
    color: var(--color-text-primary);
  }
  .spec-empty {
    font: 400 13px/18px var(--font-sans);
    color: var(--color-text-tertiary);
  }

  /* Question preview (pillar 3) */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }
  .q-box {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 14px;
    margin-top: 12px;
    min-height: 76px;
    font: 400 14px/21px var(--font-sans);
    color: var(--color-text-tertiary);
  }
  .reach {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    margin-top: 12px;
    color: var(--color-text-tertiary);
    font: 400 12px/17px var(--font-sans);
  }
  .reach :global(svg) {
    flex: none;
    margin-top: 1px;
  }

  /* CTA band */
  .cta {
    padding: clamp(24px, 4vw, 40px) 0 clamp(56px, 8vw, 88px);
    border-top: 1px solid var(--color-border);
  }
  .cta .container {
    padding-top: clamp(24px, 4vw, 40px);
  }
</style>
