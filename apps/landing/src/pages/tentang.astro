---
/**
 * Tentang — brand story and mission (AM-341). The three brand ideas (rumah,
 * jalur, huruf), the visual identity, and an honest mission: built in the
 * open, from empty, with no invented numbers or stock team photos.
 */
import Shell from "../layouts/Shell.astro";
import PageHeader from "../components/PageHeader.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import CtaBand from "../components/CtaBand.astro";

const title = "Tentang AnakMobil.id — garasi digital untuk mobilmu";
const description =
  "AnakMobil dibangun supaya riwayat mobil di Indonesia bertahan sebagai data yang rapi — buat pemiliknya, pembelinya, dan komunitasnya. Dibangun terbuka, mulai dari kosong.";
---

<Shell title={title} description={description} path="/tentang" active="tentang">
  <PageHeader
    kicker="Tentang"
    title="Rumah buat mobil kamu."
    sub="AnakMobil dimulai dari hal sederhana: riwayat mobil di Indonesia gampang hilang. Nota servis tercecer, spek build cuma ada di ingatan, dan waktu mobilnya dijual, ceritanya ikut hilang. Kami bikin tempat supaya cerita itu bertahan."
  />

  <!-- Tiga ide -->
  <section class="ideas reveal">
    <div class="container">
      <h2>Tiga ide di balik merek ini</h2>
      <div class="idea-grid">
        <div class="idea">
          <Card padding="24px" fill>
            <div class="idea-art">
              <svg viewBox="0 0 160 84" aria-hidden="true" class="art-roof">
                <path d="M18 66 L80 22 L142 66" class="ink" />
                <path d="M32 56 L32 76" class="ink" />
                <path d="M128 56 L128 76" class="ink" />
              </svg>
            </div>
            <h3>Rumah</h3>
            <p>
              Outline logonya terbaca sebagai atap. AnakMobil itu rumah buat mobil — tempat
              riwayatnya tinggal, bukan database yang dingin.
            </p>
          </Card>
        </div>
        <div class="idea">
          <Card padding="24px" fill>
            <div class="idea-art">
              <svg viewBox="0 0 160 84" aria-hidden="true" class="art-road">
                <path d="M6 64 C46 64 58 28 92 28 C120 28 128 52 154 48" class="road" />
                <circle cx="92" cy="28" r="4.5" class="road-dot"></circle>
              </svg>
            </div>
            <h3>Jalur</h3>
            <p>
              Garis oranye itu lajur jalan — perjalanan servis dan modifikasi. Satu aksen, dipakai
              hemat: aksi utama, state terpilih, garis jalur.
            </p>
          </Card>
        </div>
        <div class="idea">
          <Card padding="24px" fill>
            <div class="idea-art mono">
              <span class="mono-a">A</span><span class="mono-dot"></span>
            </div>
            <h3>Huruf</h3>
            <p>
              Monogram A / AM yang geometris — tegas, teknis, dan tetap terbaca di ukuran ikon paling
              kecil.
            </p>
          </Card>
        </div>
      </div>

      <div class="identity">
        <div class="am-label kicker">Identitas visual</div>
        <div class="identity-row">
          <div class="lockup">
            <div class="swatch">
              <img src="/logo-h.png" alt="Logo horizontal AnakMobil.id" width="180" height="44" />
            </div>
            <p class="cap">Lockup horizontal — latar terang, lebar minimum 160px.</p>
          </div>
          <div class="tiles">
            <div>
              <img
                class="tile"
                src="/tile-dark.png"
                alt="Simbol AnakMobil — tile gelap"
                width="110"
                height="110"
              />
              <p class="cap">Simbol — konteks gelap.</p>
            </div>
            <div>
              <img
                class="tile"
                src="/tile-light.png"
                alt="Simbol AnakMobil — tile terang"
                width="110"
                height="110"
              />
              <p class="cap">Simbol — konteks terang.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Misi -->
  <section class="mission reveal">
    <div class="container two-col">
      <div class="mission-text">
        <div class="am-label kicker">Misi</div>
        <h2 class="mission-h">
          Riwayat mobil di Indonesia jadi data yang rapi, bertahan, dan berguna — buat pemiliknya,
          pembelinya, dan komunitasnya.
        </h2>
        <p class="mission-p">
          Dibangun terbuka, mulai dari kosong. Tidak ada angka karangan, tidak ada testimoni palsu,
          tidak ada "ribuan member" yang sebenarnya belum ada. Progresnya publik — kodenya bisa
          dibaca siapa saja.
        </p>
        <div class="gh">
          <Button variant="secondary" href="https://github.com/oksasatya/anak-mobil">
            Lihat kodenya di GitHub
          </Button>
        </div>
      </div>
      <div class="team">
        <div class="team-box">
          <span class="team-icon"><Icon name="users" size={26} strokeWidth={1.5} /></span>
          <div class="team-h">Tim kecil. Foto menyusul.</div>
          <p>
            Belum ada foto tim yang di-brief fotografer, dan kami tidak akan pasang stok foto orang
            tersenyum. Yang bisa dilihat sekarang adalah kerjaannya.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA band -->
  <section class="cta reveal">
    <div class="container">
      <CtaBand
        heading="Ikut dari awal."
        body="Cerita ini baru mulai — dan bagian pertamanya ditulis oleh yang datang duluan."
      />
    </div>
  </section>
</Shell>

<style>
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 28px);
  }
  .kicker {
    color: var(--color-text-tertiary);
  }

  .ideas {
    border-top: 1px solid var(--color-border);
    padding: clamp(44px, 7vw, 72px) 0;
  }
  h2 {
    font: var(--type-h2);
    font-size: clamp(24px, 3.8vw, 34px);
    line-height: 1.22;
    color: var(--color-text-primary);
    margin: 0;
  }
  .idea-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: stretch;
    margin-top: 28px;
  }
  .idea {
    flex: 1 1 280px;
    min-width: min(100%, 260px);
  }
  .idea-art {
    height: 96px;
    display: flex;
    align-items: center;
  }
  .idea-art svg {
    width: 130px;
    height: auto;
  }
  .ink {
    fill: none;
    stroke: var(--color-text-primary);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .road {
    fill: none;
    stroke: var(--accent-500);
    stroke-width: 3.5;
    stroke-linecap: round;
  }
  .road-dot {
    fill: var(--accent-500);
  }
  .mono {
    align-items: baseline;
    gap: 2px;
  }
  .mono-a {
    font: 750 72px/1 var(--font-sans);
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
  }
  .mono-dot {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--accent-500);
    display: inline-block;
  }
  .idea h3 {
    font: 650 19px/25px var(--font-sans);
    color: var(--color-text-primary);
    margin: 14px 0 0;
  }
  .idea p {
    font: 400 14px/22px var(--font-sans);
    color: var(--color-text-secondary);
    margin: 8px 0 0;
  }

  .identity {
    margin-top: 36px;
  }
  .identity-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 14px;
  }
  .lockup {
    flex: 1 1 260px;
    min-width: min(100%, 240px);
    max-width: 360px;
  }
  /* Light swatch on purpose — showing the horizontal lockup on a light ground
     regardless of the page theme, so the fixed value is intentional. */
  .swatch {
    background: #f7f8fa;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 110px;
  }
  .swatch img {
    height: 44px;
    width: auto;
  }
  .cap {
    font: 400 12px/17px var(--font-sans);
    color: var(--color-text-tertiary);
    margin: 8px 0 0;
  }
  .tiles {
    display: flex;
    gap: 16px;
    flex: 0 1 auto;
  }
  .tile {
    width: 110px;
    height: 110px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .mission {
    background: var(--color-surface-subtle);
    border-top: 1px solid var(--color-border);
    padding: clamp(44px, 7vw, 72px) 0;
  }
  .two-col {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 5vw, 56px);
  }
  .mission-text {
    flex: 1 1 380px;
    min-width: min(100%, 300px);
  }
  .mission-h {
    font-size: clamp(23px, 3.4vw, 31px);
    line-height: 1.3;
    margin: 10px 0 0;
    max-width: 560px;
  }
  .mission-p {
    font: 400 15px/24px var(--font-sans);
    color: var(--color-text-secondary);
    margin: 16px 0 0;
    max-width: 560px;
  }
  .gh {
    margin-top: 20px;
  }
  .team {
    flex: 1 1 320px;
    min-width: min(100%, 280px);
    max-width: 460px;
  }
  .team-box {
    border: 1.5px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    padding: 24px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
  }
  .team-icon {
    color: var(--color-text-tertiary);
    display: inline-flex;
  }
  .team-h {
    font: 650 16px/22px var(--font-sans);
    color: var(--color-text-primary);
  }
  .team-box p {
    font: 400 13px/20px var(--font-sans);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .cta {
    padding: clamp(24px, 4vw, 40px) 0 clamp(56px, 8vw, 88px);
  }
  .cta .container {
    padding-top: clamp(24px, 4vw, 40px);
  }
</style>
