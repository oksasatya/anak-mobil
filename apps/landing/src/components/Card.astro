---
/**
 * Surface card. Mirrors the design system's AmCard (docs/design.md §15):
 * a 1px border and no shadow by default; `floating` adds the one soft shadow
 * reserved for genuinely raised things; `interactive` strengthens the border
 * on hover to signal it leads somewhere.
 *
 * `fill` makes the card a full-height flex column, so a trailing CTA can sit
 * at the bottom with `margin-top:auto` regardless of body length — the export
 * did this with an injected `fillCard` prop.
 */
export interface Props {
  padding?: number | string;
  interactive?: boolean;
  floating?: boolean;
  raised?: boolean;
  fill?: boolean;
  class?: string;
}

const {
  padding = 16,
  interactive = false,
  floating = false,
  raised = false,
  fill = false,
  class: className,
} = Astro.props;

const pad = typeof padding === "number" ? `${padding}px` : padding;
const classes = [
  "card",
  interactive && "interactive",
  floating && "floating",
  raised && "raised",
  fill && "fill",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<div class={classes} style={`--card-pad:${pad}`}>
  <slot />
</div>

<style>
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--card-pad);
    transition: border-color var(--duration-micro) var(--ease-out);
  }
  .raised {
    background: var(--color-surface-raised);
  }
  .floating {
    box-shadow: var(--shadow-soft);
  }
  .interactive {
    cursor: pointer;
  }
  .interactive:hover {
    border-color: var(--color-border-strong);
  }
  /* When the card sits inside a link, hovering the link highlights it too. */
  :global(a:hover) > .interactive {
    border-color: var(--color-border-strong);
  }
  .fill {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
</style>
