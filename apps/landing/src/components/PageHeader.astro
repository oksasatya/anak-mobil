---
/**
 * Inner-page header. Richer than a bare kicker + title: it carries the brand's
 * signature "jalur" (the orange line that recurs across the site — the hero
 * floor line, the CTA rule) and a faint depth glow, so every page opens with
 * the same confident, on-brand frame. Reveals on scroll like the rest.
 */
export interface Props {
  kicker?: string;
  title: string;
  sub?: string;
}
const { kicker, title, sub } = Astro.props;
---

<header class="ph reveal">
  <div class="container">
    <div class="ph-top">
      <span class="ph-line" aria-hidden="true"></span>
      {kicker && <span class="am-label ph-kicker">{kicker}</span>}
    </div>
    <h1>{title}</h1>
    {sub && <p class="ph-sub">{sub}</p>}
    <slot />
  </div>
</header>

<style>
  .ph {
    position: relative;
    padding: clamp(48px, 8vw, 84px) 0 clamp(32px, 5vw, 52px);
    overflow: hidden;
  }
  /* Depth: a faint orange glow anchored where the jalur line starts, low
     chroma — a considered accent, not an AI gradient wash. */
  .ph::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(
      90% 120% at 0% -10%,
      color-mix(in srgb, var(--accent-500) 8%, transparent),
      transparent 55%
    );
    pointer-events: none;
  }
  .container {
    position: relative;
    z-index: 1;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 28px);
  }
  .ph-top {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ph-line {
    width: 40px;
    height: 3px;
    border-radius: var(--radius-pill);
    background: var(--accent-500);
    flex: none;
  }
  .ph-kicker {
    color: var(--color-text-tertiary);
  }
  h1 {
    font: var(--type-h1);
    font-size: clamp(30px, 5vw, 44px);
    line-height: 1.16;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin: 16px 0 0;
    max-width: 20ch;
  }
  .ph-sub {
    font: var(--type-body);
    color: var(--color-text-secondary);
    margin: 14px 0 0;
    max-width: 640px;
  }
</style>
