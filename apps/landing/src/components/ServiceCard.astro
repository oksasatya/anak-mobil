---
/**
 * Service-history record. Mirrors the design system's AmServiceCard: an
 * odometer figure set in tabular numerals, a date, optional line items, an
 * optional note, and an optional garage/cost footer. `upcoming` tints the
 * border with the accent for a scheduled-but-not-done entry.
 *
 * On the landing this is used empty — "0 KM tercatat" — because the platform
 * launches with no data and says so (docs/design.md; AM-341).
 */
export interface Props {
  km: string;
  when?: string;
  items?: string[];
  note?: string;
  garage?: string;
  cost?: string;
  upcoming?: boolean;
  class?: string;
}

const {
  km,
  when,
  items = [],
  note,
  garage,
  cost,
  upcoming = false,
  class: className,
} = Astro.props;
const classes = ["svc", upcoming && "upcoming", className].filter(Boolean).join(" ");
---

<div class={classes}>
  <div class="head">
    <div class="km-wrap">
      {upcoming && <span class="dot" />}
      <span class="am-spec km">{km}</span>
    </div>
    {when && <span class="when">{when}</span>}
  </div>
  {
    items.length > 0 && (
      <div class="items">
        {items.map((it) => (
          <div>{it}</div>
        ))}
      </div>
    )
  }
  {note && <div class="note">{note}</div>}
  {
    (garage || cost) && (
      <div class="foot">
        <span class="garage">{garage}</span>
        {cost && <span class="am-spec cost">{cost}</span>}
      </div>
    )
  }
</div>

<style>
  .svc {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 14px;
  }
  .upcoming {
    border-color: color-mix(in srgb, var(--accent-500) 45%, var(--color-border));
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }
  .km-wrap {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 99px;
    background: var(--accent-500);
    align-self: center;
    flex: none;
  }
  .km {
    font: 650 17px/22px var(--font-sans);
    color: var(--color-text-primary);
  }
  .when {
    font: 400 12px/17px var(--font-sans);
    color: var(--color-text-tertiary);
  }
  .items {
    font: 400 14px/21px var(--font-sans);
    color: var(--color-text-primary);
    margin-top: 8px;
  }
  .note {
    font: 400 13px/19px var(--font-sans);
    color: var(--color-text-secondary);
    margin-top: 8px;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--color-border);
  }
  .garage {
    font: 400 13px/18px var(--font-sans);
    color: var(--color-text-secondary);
  }
  .cost {
    font: 600 13px/18px var(--font-sans);
    color: var(--color-text-primary);
  }
</style>
