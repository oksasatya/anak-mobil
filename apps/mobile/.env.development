# Development API base URL for the mobile app.
#
# MUST be this dev machine's LAN IP, NOT localhost — a physical phone's
# loopback is the phone itself, so a build pointed at localhost fails on a real
# device with a connection error that looks like a broken app.
#
# Find yours (macOS Wi-Fi): `ipconfig getifaddr en0`. Then run `make be-web`.
# The healthcheck screen prints whatever resolves here, so a wrong IP is
# obvious on first launch rather than a mystery failure.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8080
