# Copy to .env for local development. Never commit .env itself.
#
# ONE FILE, AT THE REPOSITORY ROOT, AND IT BELONGS TO THE BACKEND.
#
# `dotenvy` walks up from the working directory, so the API finds it when run
# from apps/api, and the Makefile loads and exports it to every recipe.
#
# Frontend apps do NOT read this file, and must not be made to. Astro and Vite
# load .env from their own project directory by default, so apps/landing gets
# its own when it needs one. The rule is not tidiness:
#
#   A credential that reaches a client bundle cannot be recalled.
#
# Vite only inlines PUBLIC_/VITE_-prefixed values into client code, but the
# whole file is read into the build process, and one misconfigured plugin or
# `define` is enough. So DATABASE_URL never lives where a bundler can see it —
# not "is not currently exposed", but is not present.
#
# Every key below is read once at startup by `Config::from_env()`.
# Missing or malformed values are ALL reported together, then the process
# exits — it never starts half-configured.

# development | production
# Production additionally refuses to start when a URL points at localhost.
APP_ENV=development

# host:port the HTTP role binds to. The port is required.
BIND_ADDR=0.0.0.0:8080

# trace | debug | info | warn | error
LOG_LEVEL=info

# Required. Must start with `postgres`.
#
# 55432 is the port `docker-compose.yml` publishes, NOT the default 5432 — a
# Homebrew postgres is commonly already listening there, and pointing at it
# instead fails confusingly: it is a real server, it just has the wrong
# database and no pgvector. The credentials match what the compose file sets
# and what CI uses.
DATABASE_URL=postgres://postgres:anakmobil@127.0.0.1:55432/anakmobil

# Required. Must start with `redis`.
# Sessions (opaque tokens, revocable), rate limiting, and read cache.
#
# 6379 whether Redis comes from your machine or from the compose file — the
# `redis` profile publishes on the same port precisely so this line never has
# to change. Run `make db-up-all` instead of `make db-up` if you have no local
# Redis.
REDIS_URL=redis://127.0.0.1:6379

# sqlx compile-time macros read the schema from a live database when
# DATABASE_URL is set, and IGNORE the committed .sqlx cache. That is why
# builds run with SQLX_OFFLINE=true — see the Makefile — so a stale cache
# fails locally instead of only in CI.
# SQLX_OFFLINE=true
